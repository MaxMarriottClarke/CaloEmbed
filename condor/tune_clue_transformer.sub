# HTCondor submit file for MOPSO tuning of CLUE on geo_transformer embeddings.
#
# Submit from the repo root:
#   condor_submit condor/tune_clue_transformer.sub
#
# Override config:
#   condor_submit condor/tune_clue_transformer.sub config=configs/tune_clue_transformer.yaml
#
# Resume a previous run:
#   condor_submit condor/tune_clue_transformer.sub extra_args=--resume
#
# Different output directory:
#   condor_submit condor/tune_clue_transformer.sub extra_args="--output results/transformer_clue_v2"
#
# To land on the best currently-available GPU node, submit via
#   SUB_FILE=condor/tune_clue_transformer.sub training/condor/submit_best_gpu.sh
# instead of calling condor_submit directly — see that script for why (this
# pool's negotiator policy always prefers the smallest whole-node GPU box, so a
# plain `rank` expression here can't reliably pick the best free GPU on its own).

universe        = vanilla
executable      = run_tune_clue_transformer.sh
arguments       = --config $(config) $(extra_args)
initialdir      = /vols/cms/mm1221/cms/CaloEmbed

config          = configs/tune_clue_transformer.yaml
extra_args      =

log             = logs/condor/tune_clue_transformer_$(ClusterId).log
output          = logs/condor/tune_clue_transformer_$(ClusterId).$(ProcId).out
error           = logs/condor/tune_clue_transformer_$(ClusterId).$(ProcId).err

# 16GB (vs 8GB for the raw tune.sub): this job additionally holds the torch
# runtime, the geo_transformer weights, and the cached per-event embeddings in
# memory.
request_CPUs    = 1
request_GPUs    = 1
request_memory  = 16GB

# target_gpu_host: quoted hostname to pin the job to, e.g.
# target_gpu_host="\"lxdgpu00.hep.ph.ic.ac.uk\"" (set by submit_best_gpu.sh).
# Left undefined, $(target_gpu_host:Machine) falls back to the tautology
# "Machine == Machine" so the clause is a no-op and matches any GPU node.
# NOTE: must NOT be assigned as a plain macro anywhere in this file — a
# same-named in-file assignment silently overrides command-line overrides.
# No capability floor: unlike training this job runs fp32 inference plus the
# pre-built CLUE fat binary, both of which are fine on P100/V100/A6000.
requirements    = (TARGET.Arch == "X86_64") && (TARGET.OpSys == "LINUX") && (TARGET.Disk >= RequestDisk) && (TARGET.Memory >= RequestMemory) && (TARGET.GPUs >= RequestGPUs) && ((TARGET.FileSystemDomain == MY.FileSystemDomain) || (TARGET.HasFileTransfer)) && (Machine == $(target_gpu_host:Machine))

# Best-effort preference only — see note above on why this alone won't
# reliably pick the best free GPU on this pool.
rank            = (GPUs_Capability * 100000) + GPUs_GlobalMemoryMb
+MaxRuntime     = 300000

queue
